1. Range GCD Query with Point Updates
import java.util.*;
public class Main{
static int[] tree;
static int gcd(int a,int b){
while(b!=0){
int temp=a%b;
a=b;
b=temp;
}
return a;
}
static void build(int index,int st,int ed,int[] arr){
if(st==ed){
tree[index]=arr[st];
return;
}
int mid=(st+ed)/2;
build(2*index+1,st,mid,arr);
build(2*index+2,mid+1,ed,arr);
tree[index]=gcd(tree[2*index+1],tree[2*index+2]);
}
static void update(int index,int st,int ed,int[] arr,int pos,int val){
if(st==ed){
arr[pos]=val;
tree[index]=val;
return;
}
int mid=(st+ed)/2;
if(pos<=mid)
update(2*index+1,st,mid,arr,pos,val);
else
update(2*index+2,mid+1,ed,arr,pos,val);
tree[index]=gcd(tree[2*index+1],tree[2*index+2]);
}
static int query(int index,int st,int ed,int l,int r){
if(r<st||l>ed)
return 0;
if(l<=st&&ed<=r)
return tree[index];
int mid=(st+ed)/2;
return gcd(query(2*index+1,st,mid,l,r),query(2*index+2,mid+1,ed,l,r));
}
public static void main(String[] args){
Scanner sc=new Scanner(System.in);
int n=sc.nextInt();
int[] arr=new int[n];
tree=new int[4*n];
for(int i=0;i<n;i++)
arr[i]=sc.nextInt();
build(0,0,n-1,arr);
int q=sc.nextInt();
while(q-->0){
int type=sc.nextInt();
if(type==1){
int index=sc.nextInt();
int value=sc.nextInt();
update(0,0,n-1,arr,index,value);
}else{
int l=sc.nextInt();
int r=sc.nextInt();
System.out.println(query(0,0,n-1,l,r));
}
}
}
}
2. Range Product Query with Point Updates
import java.util.*;
public class Main{
static final long MOD=1000000007L;
static long[] tree;
static void build(int index,int st,int ed,long[] arr){
if(st==ed){
tree[index]=arr[st]%MOD;
return;
}
int mid=(st+ed)/2;
build(2*index+1,st,mid,arr);
build(2*index+2,mid+1,ed,arr);
tree[index]=(tree[2*index+1]*tree[2*index+2])%MOD;
}
static void update(int index,int st,int ed,long[] arr,int pos,long val){
if(st==ed){
arr[pos]=val;
tree[index]=val%MOD;
return;
}
int mid=(st+ed)/2;
if(pos<=mid)
update(2*index+1,st,mid,arr,pos,val);
else
update(2*index+2,mid+1,ed,arr,pos,val);
tree[index]=(tree[2*index+1]*tree[2*index+2])%MOD;
}
static long query(int index,int st,int ed,int l,int r){
if(r<st||l>ed)
return 1;
if(l<=st&&ed<=r)
return tree[index];
int mid=(st+ed)/2;
return (query(2*index+1,st,mid,l,r)*query(2*index+2,mid+1,ed,l,r))%MOD;
}
public static void main(String[] args){
Scanner sc=new Scanner(System.in);
int n=sc.nextInt();
