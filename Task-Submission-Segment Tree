4. K-th One in a Binary Array
import java.util.*;
public class Main{
static int[] tree;
static void build(int index,int st,int ed,int[] arr){
if(st==ed){
tree[index]=arr[st];
return;
}
int mid=(st+ed)/2;
build(2*index+1,st,mid,arr);
build(2*index+2,mid+1,ed,arr);
tree[index]=tree[2*index+1]+tree[2*index+2];
}
static void update(int index,int st,int ed,int[] arr,int pos,int val){
if(st==ed){
arr[pos]=val;
tree[index]=val;
return;
}
int mid=(st+ed)/2;
if(pos<=mid)
update(2*index+1,st,mid,arr,pos,val);
else
update(2*index+2,mid+1,ed,arr,pos,val);
tree[index]=tree[2*index+1]+tree[2*index+2];
}
static int kthOne(int index,int st,int ed,int k){
if(st==ed)
return st;
int mid=(st+ed)/2;
int leftCount=tree[2*index+1];
if(k<=leftCount)
return kthOne(2*index+1,st,mid,k);
else
return kthOne(2*index+2,mid+1,ed,k-leftCount);
}
public static void main(String[] args){
Scanner sc=new Scanner(System.in);
int n=sc.nextInt();
int[] arr=new int[n];
tree=new int[4*n];
