arr[i]=sc.nextInt();
build(0,0,n-1,arr);
int q=sc.nextInt();
while(q-->0){
int type=sc.nextInt();
if(type==1){
int index=sc.nextInt();
int value=sc.nextInt();
update(0,0,n-1,arr,index,value);
}else{
int k=sc.nextInt();
if(tree[0]<k)
System.out.println(-1);
else
System.out.println(kthOne(0,0,n-1,k));
}
}
}
}
5. First Element Greater Than or Equal to X in a Range
import java.util.*;
public class Main{
static int[] tree;
static void build(int index,int st,int ed,int[] arr){
if(st==ed){
tree[index]=arr[st];
return;
}
int mid=(st+ed)/2;
build(2*index+1,st,mid,arr);
build(2*index+2,mid+1,ed,arr);
tree[index]=Math.max(tree[2*index+1],tree[2*index+2]);
}
static void update(int index,int st,int ed,int[] arr,int pos,int val){
if(st==ed){
arr[pos]=val;
tree[index]=val;
return;
}
int mid=(st+ed)/2;
if(pos<=mid)
update(2*index+1,st,mid,arr,pos,val);
else
update(2*index+2,mid+1,ed,arr,pos,val);
tree[index]=Math.max(tree[2*index+1],tree[2*index+2]);
}
static int firstGreaterEqual(int index,int st,int ed,int l,int r,int x){
if(r<st||l>ed)
return -1;
if(tree[index]<x)
return -1;
if(st==ed)
return st;
int mid=(st+ed)/2;
int leftAnswer=firstGreaterEqual(2*index+1,st,mid,l,r,x);
if(leftAnswer!=-1)
return leftAnswer;
return firstGreaterEqual(2*index+2,mid+1,ed,l,r,x);
}
